{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drupal-knowledge.zarabatana.info/schema/implementation-rule-v0.1.json",
  "title": "Drupal Knowledge implementation rule",
  "description": "One reviewed piece of implementation guidance that can be evaluated against canonical project evidence. Authority is a registered authoritative source pinned to the snapshot the rule was reviewed against, so a rule cannot outlive the sentence it was built on. Severity is never established by this product, and a category never sets enforcement: only a human review does.",
  "type": "object",
  "required": [
    "rule_contract_version",
    "rule_id",
    "category",
    "title",
    "summary",
    "review",
    "authority",
    "scope",
    "check",
    "finding"
  ],
  "properties": {
    "rule_contract_version": {"type": "string"},
    "rule_id": {"type": "string", "pattern": "^(performance|security|configuration_quality)\\.[a-z][a-z0-9-]*$"},
    "category": {"enum": ["performance", "security", "configuration_quality"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "review": {
      "description": "Only a reviewed rule may confirm a finding. A draft rule still evaluates so its author can see what it would say, but its findings are capped at candidate.",
      "type": "object",
      "required": ["status", "reviewed_on", "authority"],
      "properties": {
        "status": {"enum": ["draft", "reviewed", "deprecated", "superseded"]},
        "reviewed_on": {"type": ["string", "null"]},
        "authority": {"type": "string"},
        "superseded_by": {"type": "string"}
      },
      "additionalProperties": false
    },
    "authority": {
      "description": "A rule with no authoritative source is a preference. Each reference pins the snapshot it was reviewed against and quotes the lines it rests on.",
      "type": "object",
      "required": ["summary", "sources"],
      "properties": {
        "summary": {"type": "string"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "snapshot_sha256", "quotes"],
            "properties": {
              "source_id": {"type": "string"},
              "snapshot_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "quotes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["component", "notes"],
      "properties": {
        "drupal_core_minimum_major": {"type": ["integer", "null"]},
        "component": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "check": {
      "description": "Exactly two kinds with fixed semantics. A condition is evaluated by the one applicability resolver; a cross reference is one declared join between two evidence assertions. This is deliberately not a rules language.",
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "properties": {
            "kind": {"const": "evidence_condition"},
            "condition": {"type": "object"}
          },
          "required": ["kind", "condition"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {"const": "evidence_cross_reference"},
            "source_assertion": {"type": "string"},
            "source_value_path": {"type": "string"},
            "source_subject_prefix": {"type": "string"},
            "target_assertion": {"type": "string"}
          },
          "required": ["kind", "source_assertion", "target_assertion"],
          "additionalProperties": false
        }
      ]
    },
    "context_requirements": {
      "description": "What the rule would need to know to be certain. Where the evidence cannot supply it, the finding stays a candidate with the gap written down.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assertion", "subject", "why_it_matters"],
        "properties": {
          "assertion": {"type": "string"},
          "subject": {"type": "string"},
          "why_it_matters": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "assertion",
        "human_title",
        "severity_state",
        "enforcement_intent",
        "evidence_explanation",
        "conclusion",
        "remediation",
        "limitations"
      ],
      "properties": {
        "assertion": {"type": "string"},
        "human_title": {"type": "string"},
        "severity_state": {
          "description": "This product does not manufacture severity.",
          "const": "not_established"
        },
        "enforcement_intent": {"enum": ["guidance", "advisory", "blocking"]},
        "evidence_explanation": {"type": "string"},
        "conclusion": {
          "type": "object",
          "required": ["default"],
          "additionalProperties": {"type": "string"}
        },
        "remediation": {
          "type": "object",
          "required": ["guidance", "basis", "applied"],
          "properties": {
            "guidance": {"type": "string"},
            "basis": {"enum": ["drupal_documentation", "drupal_core_source", "project_specific_guidance"]},
            "applied": {"const": false}
          },
          "additionalProperties": false
        },
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
