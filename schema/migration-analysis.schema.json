{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drupal-knowledge.zarabatana.info/schema/migration-analysis-v0.1.json",
  "title": "Drupal Knowledge API migration analysis",
  "description": "A read-only, deterministic analysis of what custom-code migration work one project needs for one target Drupal version. Usage is observed from a lexed PHP token stream, so a name in a comment or a string is never a usage; lifecycle comes from authoritative deprecation annotations; and coverage is first-class because finding no match is not a compatibility proof. No code is modified.",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "result_domain",
    "engine",
    "generated_at",
    "project",
    "target",
    "summary",
    "work_items",
    "observed_without_lifecycle_record",
    "rejected_non_code_matches",
    "unsupported_constructs",
    "unread_files",
    "unknowns",
    "coverage",
    "relationship_to_security",
    "execution",
    "trusted_knowledge_mutations"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "analysis_id": {"type": "string", "pattern": "^migration-analysis\\.[a-f0-9]{16}$"},
    "result_domain": {"const": "api_migration"},
    "engine": {
      "type": "object",
      "required": ["name", "version", "deterministic", "language_model_used", "produces_trusted_knowledge"],
      "properties": {
        "name": {"const": "drupal-knowledge-migration-engine"},
        "version": {"type": "string"},
        "deterministic": {"const": true},
        "language_model_used": {"const": false},
        "produces_trusted_knowledge": {"const": false}
      },
      "additionalProperties": false
    },
    "generated_at": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["project_id", "facts_source", "project_fingerprint", "current_core_version"],
      "properties": {
        "project_id": {"type": ["string", "null"]},
        "facts_source": {"const": "drupal_project_analyzer_profile_facts"},
        "project_fingerprint": {"type": "string"},
        "current_core_version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["drupal_version"],
      "properties": {"drupal_version": {"type": "string"}},
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "custom_components_scanned",
        "files_inventoried",
        "files_read",
        "observations",
        "work_items",
        "by_effect",
        "blocking_items",
        "non_blocking_items",
        "migration_required_items",
        "occurrences",
        "non_code_matches_rejected",
        "observed_symbols_without_lifecycle_record"
      ],
      "properties": {
        "custom_components_scanned": {"type": "integer", "minimum": 0},
        "files_inventoried": {"type": "integer", "minimum": 0},
        "files_read": {"type": "integer", "minimum": 0},
        "observations": {"type": "integer", "minimum": 0},
        "work_items": {"type": "integer", "minimum": 0},
        "by_effect": {"type": "object"},
        "blocking_items": {"type": "integer", "minimum": 0},
        "non_blocking_items": {"type": "integer", "minimum": 0},
        "migration_required_items": {"type": "integer", "minimum": 0},
        "occurrences": {"type": "integer", "minimum": 0},
        "non_code_matches_rejected": {"type": "integer", "minimum": 0},
        "observed_symbols_without_lifecycle_record": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "work_items": {"type": "array"},
    "observed_without_lifecycle_record": {
      "description": "Symbols the project uses that the deprecation index does not list. Absence usually means current, but a symbol removed before the indexed branch is absent too, so it settles nothing.",
      "type": "array"
    },
    "rejected_non_code_matches": {
      "description": "Names found only in comments, docblocks or strings. Reported so the decision not to treat them as usage is visible rather than silent.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "line", "symbol", "found_in", "evidence_quality", "treated_as_usage"],
        "properties": {
          "path": {"type": "string"},
          "line": {"type": "integer"},
          "symbol": {"type": "string"},
          "found_in": {"type": "string"},
          "evidence_quality": {"const": "non_code_text_only"},
          "treated_as_usage": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "unsupported_constructs": {"type": "array"},
    "unread_files": {"type": "array"},
    "unknowns": {"type": "array", "items": {"type": "object"}},
    "coverage": {
      "description": "What was examined and what was not. Without this, silence would read as a clean bill of health.",
      "type": "object",
      "required": ["custom_code", "lifecycle_authority", "unsupported_constructs", "statement"],
      "properties": {
        "custom_code": {
          "type": "object",
          "required": ["scope", "config_id", "config_digest", "languages_supported", "php_analysis", "yaml_analysis", "files_inventoried", "files_read", "files_skipped_by_scan", "truncated", "contrib_source_scanned", "vendor_scanned"],
          "properties": {
            "scope": {"type": "string"},
            "config_id": {"type": ["string", "null"]},
            "config_digest": {"type": ["string", "null"]},
            "languages_supported": {"type": "array", "items": {"type": "string"}},
            "php_analysis": {"const": "syntax_aware_lexer_not_full_parser"},
            "yaml_analysis": {"type": "string"},
            "files_inventoried": {"type": "integer", "minimum": 0},
            "files_read": {"type": "integer", "minimum": 0},
            "files_skipped_by_scan": {"type": "integer", "minimum": 0},
            "truncated": {"type": "boolean"},
            "contrib_source_scanned": {"const": false},
            "vendor_scanned": {"const": false}
          },
          "additionalProperties": false
        },
        "lifecycle_authority": {"type": "object"},
        "unsupported_constructs": {"type": "array", "items": {"type": "string"}},
        "statement": {"type": "string"}
      },
      "additionalProperties": false
    },
    "relationship_to_security": {"type": "string"},
    "execution": {
      "description": "Structural. There is no code path in the engine that can set any of these true.",
      "type": "object",
      "required": ["execution_performed", "code_modified", "files_written", "rector_invoked", "composer_invoked"],
      "properties": {
        "execution_performed": {"const": false},
        "code_modified": {"const": false},
        "files_written": {"const": false},
        "rector_invoked": {"const": false},
        "composer_invoked": {"const": false}
      },
      "additionalProperties": false
    },
    "trusted_knowledge_mutations": {
      "type": "object",
      "required": ["knowledge_records", "reviewed_context", "advisories", "solved_cases", "source_snapshots"],
      "properties": {
        "knowledge_records": {"const": 0},
        "reviewed_context": {"const": 0},
        "advisories": {"const": 0},
        "solved_cases": {"const": 0},
        "source_snapshots": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
