      "source_id": "drupal-upgrade-process-overview",
      "source_text": [
        "A major version",
        "be skipped during an upgrade. For example, to upgrade from Drupal 9 to Drupal 11, a site must upgrade from Drupal 9 to Drupal 10, and then to Drupal 11.",
        "This is necessary, because only updates via"
      ],
      "source_url": "https://www.drupal.org/docs/upgrading-drupal/upgrading-drupal/upgrade-process-overview"
    },
    "reason_source_text": "This is necessary, because only updates via",
    "semantics": "The absence of a registered transition is never evidence that the transition is supported. Only a transition listed below has authority.",
    "skip_major_supported": false
  },
  "non_inference": {
    "not_inferred_conclusions": [
      "a transition that is not listed here is not thereby supported",
      "a TBA or absent requirement is unknown and is never filled in from another transition",
      "a removed-extension list that the source does not close is never treated as closed",
      "PHP support for a Drupal minor outside the published matrix is unknown, not inherited from its major",
      "no project upgrade recommendation is inferred from this context alone"
    ]
